#!/usr/bin/env bash
# Ouvre le portefeuille du nœud dans une fenêtre d'application (profil de navigateur séparé), sinon dans le navigateur.
API=${1:-127.0.0.1:8861}; PREFIXE=${2:-$HOME/.local/share/vision-noeud}
for b in google-chrome chromium chromium-browser brave-browser microsoft-edge; do
  if command -v "$b" >/dev/null; then
    exec "$b" --app="http://$API/" --user-data-dir="$PREFIXE/navigateur" --window-size=1280,860 --no-first-run
  fi
done
exec xdg-open "http://$API/"
