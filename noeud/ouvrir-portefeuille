#!/usr/bin/env bash
# Ouvre le portefeuille du nœud dans une fenêtre d'application (profil de navigateur séparé), sinon dans le navigateur.
# Le passe local transite par un fichier privé : sur une ligne de commande, les autres comptes de la machine pourraient le lire.
# Linux, macOS et Android (Termux) ; sous Windows, l'installateur .ps1 pose ouvrir-portefeuille.ps1, qui fait la même chose.
API=${1:-127.0.0.1:8861}; PREFIXE=${2:-$HOME/.local/share/vision-noeud}
umask 077
PASSE=$(cat "$PREFIXE/cles/passe-local" 2>/dev/null)
if command -v termux-open-url >/dev/null 2>&1; then
  # Android (Termux) : le navigateur ne peut pas lire un fichier privé de Termux ; l'adresse lui est remise directement
  # et la page efface aussitôt le fragment de la barre d'adresse.
  exec termux-open-url "http://$API/#passe=$PASSE"
fi
# X en fin de modèle : le mktemp de macOS (BSD) n'accepte pas de suffixe après les X
ENTREE=$(mktemp "$PREFIXE/.ouvrir-XXXXXX") && mv "$ENTREE" "$ENTREE.html" && ENTREE="$ENTREE.html" || exit 1
printf '<!doctype html><meta charset="utf-8"><script>location.replace("http://%s/#passe=%s")</script>\n' "$API" "$PASSE" > "$ENTREE"
( sleep 20; rm -f "$ENTREE" ) >/dev/null 2>&1 </dev/null &
if [ "$(uname -s)" = Darwin ]; then
  for b in "Google Chrome" "Chromium" "Brave Browser" "Microsoft Edge"; do
    if open -Ra "$b" 2>/dev/null; then
      exec open -na "$b" --args --app="file://$ENTREE" --user-data-dir="$PREFIXE/navigateur" --window-size=1280,860 --no-first-run
    fi
  done
  exec open "$ENTREE"      # navigateur par défaut (Safari, Firefox…)
fi
for b in google-chrome chromium chromium-browser brave-browser microsoft-edge msedge; do
  if command -v "$b" >/dev/null; then
    exec "$b" --app="file://$ENTREE" --user-data-dir="$PREFIXE/navigateur" --window-size=1280,860 --no-first-run
  fi
done
if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "file://$ENTREE"
elif command -v cmd.exe >/dev/null 2>&1; then
  exec cmd.exe /c start "" "http://$API/#passe=$PASSE"
fi
