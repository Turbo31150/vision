#!/usr/bin/env bash
# Construit les installateurs à partir de ce dépôt : modèle + archive (nœud, outil de chaîne, portefeuille, icône).
#   docs/installer-noeud-vision.sh    Linux et macOS (bash)
#   docs/installer-noeud-vision.ps1   Windows 10 et 11 (PowerShell) : même archive, mêmes valeurs épinglées
# La clé publique du producteur et l'empreinte du bloc 0 viennent du miroir public (docs/chaine/info.json) :
# n'importe qui peut reconstruire les installateurs et comparer leurs empreintes sha256 à celles qui sont publiées.
# La construction demande les outils GNU (tar --sort, base64 -w) : elle se fait sous Linux.
#   installateur/construire-installateur [URL-du-miroir] [propriétaire/dépôt]
set -euo pipefail
RACINE=$(cd "$(dirname "$0")/.." && pwd)
MIROIR=${1:-https://turbo31150.github.io/vision/chaine}
DEPOT=${2:-Turbo31150/vision}
INFO="$RACINE/docs/chaine/info.json"
PUB=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['producteur_pub'])" "$INFO")
B0=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['bloc0'])" "$INFO")
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
mkdir "$T/archive"
cp "$RACINE/noeud/vision-noeud" "$RACINE/noeud/ouvrir-portefeuille" "$RACINE/noeud/icone.ico" "$RACINE/chaine/vision-chaine" "$T/archive/"
# seulement les fichiers suivis par git : les sauvegardes locales ignorées (*.avant-*, *.mis-de-cote-*) ne doivent
# jamais partir dans l'archive publiée, et deux constructions du même commit doivent donner les mêmes empreintes
mkdir "$T/archive/ui"
if git -C "$RACINE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$RACINE" ls-files -z -- noeud/ui | while IFS= read -r -d '' f; do cp "$RACINE/$f" "$T/archive/ui/"; done
else
  find "$RACINE/noeud/ui" -maxdepth 1 -type f ! -name '*.avant-*' ! -name '*.mis-de-cote-*' -exec cp {} "$T/archive/ui/" \;
fi
# date fixe = celle du bloc de tête : deux constructions du même état donnent les mêmes fichiers
DATE=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['genere_le'][:10])" "$INFO")
tar -C "$T/archive" --sort=name --mtime="$DATE 00:00Z" --owner=0 --group=0 --numeric-owner -c . | gzip -n | base64 -w 76 > "$T/charge.b64"
remplir() {
  sed -e "s|@@PRODUCTEUR_PUB@@|$PUB|" -e "s|@@BLOC0@@|$B0|g" -e "s|@@PAIR@@||" -e "s|@@MIROIR@@|$MIROIR|" -e "s|@@DEPOT@@|$DEPOT|" \
      -e "s|@@DATE@@|$DATE|" -e "s|@@PRODUCTEUR_COURT@@|${PUB:12:24}…|" "$1"
}

# Linux et macOS : script bash, puis l'archive après la ligne __CHARGE__
SORTIE="$RACINE/docs/installer-noeud-vision.sh"
remplir "$RACINE/installateur/installateur.sh.modele" > "$SORTIE"
cat "$T/charge.b64" >> "$SORTIE"
chmod 755 "$SORTIE"

# Windows : script PowerShell en UTF-8 avec BOM (sans BOM, Windows PowerShell 5.1 lirait les accents en ANSI) ;
# l'archive remplace la ligne @@CHARGE@@ d'une chaîne littérale @' … '@
SORTIE_PS1="$RACINE/docs/installer-noeud-vision.ps1"
{ printf '\357\273\277'; remplir "$RACINE/installateur/installer-noeud-vision.ps1.modele" | sed -e "/^@@CHARGE@@\$/{r $T/charge.b64" -e 'd;}'; } > "$SORTIE_PS1"
chmod 644 "$SORTIE_PS1"
if grep -n '@@[A-Z_0-9]*@@' "$SORTIE" "$SORTIE_PS1"; then     # le base64 ne contient jamais @
  echo "marqueur non remplacé ci-dessus" >&2; exit 1
fi

(cd "$RACINE/docs" && sha256sum installer-noeud-vision.sh > installer-noeud-vision.sh.sha256 \
                   && sha256sum installer-noeud-vision.ps1 > installer-noeud-vision.ps1.sha256)
echo "installateurs : $SORTIE ($(du -h "$SORTIE" | cut -f1)), $SORTIE_PS1 ($(du -h "$SORTIE_PS1" | cut -f1)) · miroir $MIROIR · dépôt $DEPOT"
cat "$RACINE/docs/installer-noeud-vision.sh.sha256" "$RACINE/docs/installer-noeud-vision.ps1.sha256"
