def cmd_collecter(a):
    bloc0, blocs, soldes, _ = etat_courant()
    if not blocs:
        raise Refus("chaîne vide")
    paquet = canon({"bloc0": bloc0, "blocs": blocs})
    tete = blocs[-1]["empreinte"]
    vus = {c["machine"] for c in lire_jsonl(DOSSIER / F_COSIGN) if c.get("empreinte") == tete}
    for m, lance in TEMOINS.items():
        if m in vus:
            print(f"{m} : déjà cosigné")
            continue
        r = subprocess.run([*lance, f"python3 -B {DOSSIER_TEMOIN}/vision-chaine cosigner --dossier {DOSSIER_TEMOIN}"],
                           input=paquet, capture_output=True, text=True, timeout=120)
        if r.returncode:
            print(f"{m} : REFUS ou injoignable — {(r.stdout + r.stderr).strip()[-200:]}")
            continue
        c = json.loads(r.stdout.strip().splitlines()[-1])
        pub = (DOSSIER / f"temoin-{m}.pub").read_text().strip() if (DOSSIER / f"temoin-{m}.pub").exists() else None
        if not pub:
            print(f"{m} : clé du témoin non épinglée sur m0 ({DOSSIER}/temoin-{m}.pub)")
            continue
        if c.get("machine") != m or c.get("empreinte") != tete or not verifier_sig(
                f"{c['hauteur']}:{c['empreinte']}", c["signature"], pub, m, ESPACE_COSIGN):
            print(f"{m} : cosignature invalide, ignorée")
            continue
        ajouter_jsonl(DOSSIER / F_COSIGN, c)
        print(f"{m} : tête {c['hauteur']} cosignée ({c['soldes_controle']})")


