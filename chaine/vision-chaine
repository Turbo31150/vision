BLOC0 = Path(os.environ.get("VISION_BLOC0", ACCUEIL / ".local/share/vision/bloc0.json"))
CLE = Path(os.environ.get("VISION_CLE", ACCUEIL / ".ssh/producteur_chaine_ed25519"))   # dédiée aux blocs d'essai, rien d'autre
VISION = Path(os.environ.get("VISION_JOURNAL", "/nonexistent"))
CHAINE = "vision-essai"
FORMAT = "vision-bloc/1"
ESPACE_BLOC = "vision-bloc"
ESPACE_COSIGN = "vision-cosignature"
ESPACE_CLE = "vision-cle"
PRODUCTEUR = "m0"
ACTIVES = {"reserve:usage"}          # seule réserve qui circule
DESTRUCTION_PCT = 20                 # bloc 0 : 20 % des unités dépensées sont détruites
TAUX_SECONDE = 1                     # récompense : unités par seconde de calcul vérifiée

# ── Règles v2 : rétribution par époque ──
# Époque de 7 jours, frontière le mercredi 12:00 UTC. La réserve usage est libérée sur 4 ans
# (208 époques), budget divisé par deux chaque année (halving) ; une époque n'émet que ce que l'usage vérifié justifie.
# Deux scores, recalculables par tout nœud à partir de la transaction d'époque :
#   travail    : secondes de calcul d'une étape validée (≥ 1 reçu PASS, aucun FAIL) × poids de la preuve
#                (rejeu exact 2, propriétés 1) → au nœud qui a exécuté ;
#   validation : 1 point par reçu PASS ou FAIL signé → au nœud qui a vérifié (INCONCLUSIVE ne paie rien).
# Parts au prorata des points ; le reliquat d'arrondi et le budget non justifié restent dans la réserve (pas
# d'« Arbitrator »). Les dépenses ne paient plus un nœud directement : 20 % détruits, 80 % recyclés dans la réserve.
# Aucun nœud ne certifie seul sa récompense (tâche #2034, DEC-03) : la clôture d'époque porte ses justificatifs et
# tout pair, tout témoin les rejoue (`controler_independance`) — chaque travail cite au moins un reçu PASS d'une autre
# machine que l'exécutant et que le signataire du journal de mission, un reçu ne paie qu'une étape, un rejeu exact
# revendiqué exige un reçu de rejeu exact, une validation ne vient jamais d'un auteur de l'étape, un FAIL scellé bloque
# l'étape. Là où le journal VISION signé est présent, chaque reçu cité y est en plus retrouvé (`controler_recus_journal`).
EPOQUE_0 = datetime(2026, 10, 28, 12, 0, tzinfo=timezone.utc)   # mercredi 12:00 UTC
EPOQUE_S = 7 * 24 * 3600
EPOQUES_TOTAL = 208                  # 4 ans d'époques hebdomadaires
BUDGET_0 = 358_974                   # 52 × B0 × (1 + ½ + ¼ + ⅛) ≈ 35 000 000 : la réserve usage sur 4 ans
POIDS_GARANTIE = {"rejeu-exact": 2, "proprietes": 1}


def fenetre(k):
    d = EPOQUE_0.timestamp() + k * EPOQUE_S
    f = lambda t: datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")  # noqa: E731
    return f(d), f(d + EPOQUE_S)


def epoque_de(horodatage):
    t = datetime.strptime(horodatage, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    return int((t - EPOQUE_0.timestamp()) // EPOQUE_S)


def budget_epoque(k):
    return 0 if not 0 <= k < EPOQUES_TOTAL else BUDGET_0 >> (k // 52)


def points(c):
    if c.get("role") == "travail":
        return max(1, math.ceil(int(c["duree_ms"]) / 1000)) * TAUX_SECONDE * POIDS_GARANTIE.get(c.get("garantie"), 1)
    if c.get("role") == "validation":
        return 1
    raise Refus(f"contribution de rôle inconnu : {c.get('role')!r}")


def repartir(contributions, budget, disponible):
    """Calcul déterministe d'une fin d'époque (l'équivalent de computeRevenue) : scores, émis, attributions."""
    scores = {}
    for c in contributions:
        scores[c["noeud"]] = scores.get(c["noeud"], 0) + points(c)
    justifie = sum(scores.values())
    emis_max = min(budget, justifie, disponible)
    attrib = {n: s * emis_max // justifie for n, s in sorted(scores.items())} if justifie else {}
    attrib = {n: u for n, u in attrib.items() if u > 0}
    return {"scores": dict(sorted(scores.items())), "justifie": justifie, "emis": sum(attrib.values()),
            "attributions": attrib}
TEMOINS = {"m6": ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", "m6"],
           "m1": ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", "m1"]}
DOSSIER_TEMOIN = "~/vision-temoin"
NOM = re.compile(r"[a-z0-9][a-z0-9._-]{0,47}")
ZERO = "0" * 64


class Refus(Exception):
    pass


# ── empreintes ──────────────────────────────────────────────────────────────────────────────────────
def canon(x):
    return json.dumps(x, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def sha(t):
    return hashlib.sha256(t.encode() if isinstance(t, str) else t).hexdigest()


def id_tx(tx):
    return sha(canon({k: v for k, v in tx.items() if k != "id"}))


def merkle(ids):
    if not ids:
        return sha("")
    niveau = list(ids)
    while len(niveau) > 1:
        if len(niveau) % 2:
            niveau.append(niveau[-1])
        niveau = [sha(niveau[i] + niveau[i + 1]) for i in range(0, len(niveau), 2)]
    return niveau[0]


def corps(b):
    return {k: v for k, v in b.items() if k not in ("empreinte", "signature")}


def maintenant():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ── signature ssh-keygen ────────────────────────────────────────────────────────────────────────────
# Sans agent : un agent SSH de session (trousseau GNOME, gcr) peut attendre une saisie et bloquer la signature.
SANS_AGENT = {k: v for k, v in os.environ.items() if k != "SSH_AUTH_SOCK"}
# Windows : sans console (pythonw), chaque appel ouvrirait une fenêtre ; ce drapeau la supprime. Rien ailleurs.
SANS_FENETRE = {"creationflags": subprocess.CREATE_NO_WINDOW} if os.name == "nt" else {}


def signer(texte, cle, espace):
    with tempfile.TemporaryDirectory() as t:
        f = Path(t) / "m"
        f.write_text(texte, encoding="utf-8", newline="\n")
        r = subprocess.run(["ssh-keygen", "-Y", "sign", "-f", str(cle), "-n", espace, str(f)],
                           capture_output=True, text=True, stdin=subprocess.DEVNULL, env=SANS_AGENT, timeout=20,
                           **SANS_FENETRE)
        if r.returncode:
            raise Refus(f"signature impossible : {r.stderr.strip()[:200]}")
        return (Path(t) / "m.sig").read_text(encoding="utf-8")


def verifier_sig(texte, signature, pub, identite, espace):
    """Le message arrive par l'entrée standard redirigée depuis un fichier (comme « < m »), pas par un tube : sous
    Windows, ssh-keygen lit mal un tube, et le mode texte du tube y changerait les fins de ligne et l'encodage.
    Sous Linux et macOS, ssh-keygen reçoit les mêmes octets UTF-8 qu'avant : même verdict."""
    with tempfile.TemporaryDirectory() as t:
        (Path(t) / "s").write_text(signature, encoding="utf-8", newline="\n")
        (Path(t) / "a").write_text(f'{identite} namespaces="{espace}" {pub}\n', encoding="utf-8", newline="\n")
        (Path(t) / "m").write_text(texte, encoding="utf-8", newline="\n")
        with open(Path(t) / "m", "rb") as message:
            try:
                r = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", str(Path(t) / "a"), "-I", identite, "-n",
                                    espace, "-s", str(Path(t) / "s")], stdin=message, capture_output=True, text=True,
                                   env=SANS_AGENT, timeout=8 if os.name == "nt" else 20, **SANS_FENETRE)
            except subprocess.TimeoutExpired:
                # Windows (OpenSSH 9.5.6.4, mesuré le 02/11/2026) : sur une signature FAUSSE, ssh-keygen -Y verify ne
                # rend jamais la main ; une bonne signature répond en moins d'une seconde. Le délai écoulé vaut donc
                # refus : seule une sortie 0 accepte une signature. Ailleurs, le comportement ne change pas.
                if os.name != "nt":
                    raise
                return False
        return r.returncode == 0


def pub_de(cle):
    p = Path(str(cle) + ".pub")
    if not p.exists():
        raise Refus(f"clé publique absente : {p}")
    a = p.read_text(encoding="utf-8").split()
    return f"{a[0]} {a[1]}"


# ── état ────────────────────────────────────────────────────────────────────────────────────────────
def lire_jsonl(f):
    if not f.exists():
        return []
    return [json.loads(l) for l in f.read_text(encoding="utf-8").splitlines() if l.strip()]


def ecrire_jsonl(f, lignes):
    f.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = f.with_suffix(".tmp")
    tmp.write_text("".join(canon(x) + "\n" for x in lignes), encoding="utf-8", newline="\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, f)


def ajouter_jsonl(f, x):
    f.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(f, "a", encoding="utf-8", newline="\n") as h:
        h.write(canon(x) + "\n")
    os.chmod(f, 0o600)


ESPACE_TX = "vision-tx"
ESPACE_TX_V3 = ESPACE_TX + "@3"     # domaine du format anti-rejeu : une signature v1 ne vaut jamais en v3, ni l'inverse
# ── Anti-rejeu : règle de CONSENSUS, identique sur tous les nœuds ──────────────────────────────
#   * registre des transactions consommées, actif dès le bloc 1 :
#     preuve « tx:<sha256 du message signé> ». Le message exclut `id` et `signature` : une armure de signature
#     retouchée (saut de ligne final, CRLF) garde sa validité mais ne donne PAS un second passage ;
#   * à partir de HAUTEUR_ANTI_REJEU, toute transaction signée porte `chaine`, `bloc0` et `seq` (compteur par
#     signataire : 1, 2, 3… sans trou ni réutilisation) et se signe dans ESPACE_TX_V3 ; `valide_jusqu_a` facultatif.
HAUTEUR_ANTI_REJEU = 3
ADRESSE = re.compile(r"te1[0-9a-f]{40}")
PUB = re.compile(r"ssh-ed25519 [A-Za-z0-9+/=]{60,80}")


def adresse(pub):
    """Adresse de portefeuille : te1 + 40 hex de l'empreinte de la clé publique ed25519 (« type base64 »)."""
    p = " ".join(pub.split()[:2])
    if not PUB.fullmatch(p):
        raise Refus("clé publique ed25519 invalide")
    return "te1" + sha(p)[:40]


def message_tx(tx):
    return canon({k: v for k, v in tx.items() if k not in ("id", "signature")})


def signer_tx(tx, cle, espace=ESPACE_TX):
    """Signe une transaction avec la clé d'un portefeuille ou d'un nœud. La clé privée reste où elle est."""
    tx["signature"] = signer(message_tx(tx), cle, espace)
    tx["id"] = id_tx(tx)
    return tx


def controler_signature(tx, identite, espace=ESPACE_TX):
    if not PUB.fullmatch(" ".join(str(tx.get("cle", "")).split()[:2])):
        raise Refus("transaction signée sans clé publique valide")
    if not verifier_sig(message_tx(tx), tx.get("signature", ""), tx["cle"], identite, espace):
        raise Refus("signature de la transaction invalide")


def registre_tx(tx):
    """Registre des transactions consommées : empreinte du MESSAGE signé (sans `id` ni `signature`)."""
    return "tx:" + sha(message_tx(tx))


def v3_active(hauteur):
    return HAUTEUR_ANTI_REJEU is not None and hauteur is not None and hauteur >= HAUTEUR_ANTI_REJEU


def controler_v3(tx, bloc0, preuves, hauteur):
    """Format signé v3 : liée à CETTE chaîne, séquence stricte par signataire, échéance facultative."""
    n = tx.get("seq")
    if not isinstance(n, int) or isinstance(n, bool) or n < 1:
        raise Refus(f"format signé v3 exigé depuis le bloc {HAUTEUR_ANTI_REJEU} : seq absent ou invalide")
    if tx.get("chaine") != CHAINE or tx.get("bloc0") != bloc0["empreinte"]:
        raise Refus("transaction signée pour une autre chaîne (chaine ou bloc0 différent)")
    fin = tx.get("valide_jusqu_a")
    if fin is not None and (not isinstance(fin, int) or isinstance(fin, bool) or hauteur > fin):
        raise Refus(f"transaction expirée (valide jusqu'au bloc {fin!r})")
    a = adresse(tx.get("cle", ""))
    if f"seq:{a}:{n}" in preuves or (n > 1 and f"seq:{a}:{n - 1}" not in preuves):
        raise Refus(f"séquence {n} hors ordre pour {a[:14]}…")
    return f"seq:{a}:{n}"


def prochain_seq(preuves, pub, en_attente=()):
    a, n = adresse(pub), 1
    while f"seq:{a}:{n}" in preuves:
        n += 1
    autres = [t["seq"] for t in en_attente if isinstance(t.get("seq"), int)
              and " ".join(str(t.get("cle", "")).split()[:2]) == " ".join(pub.split()[:2])]
    return max([n] + [x + 1 for x in autres])


def signer_pour(tx, cle, bloc0, preuves, hauteur, en_attente=()):
    """Signe au format en vigueur pour le bloc `hauteur` qui la scellera (v1 avant l'activation, v3 ensuite)."""
    if v3_active(hauteur):
        tx.update(chaine=CHAINE, bloc0=bloc0["empreinte"], seq=prochain_seq(preuves, pub_de(cle), en_attente))
        return signer_tx(tx, cle, ESPACE_TX_V3)
    return signer_tx(tx, cle)


def charger_bloc0(chemin=None):
    b0 = json.loads(Path(chemin or BLOC0).read_text())
    recalc = sha(json.dumps({k: v for k, v in b0.items() if k not in ("empreinte", "signature")},
                            ensure_ascii=False, sort_keys=True))
    if recalc != b0.get("empreinte"):
        raise Refus("bloc 0 altéré : empreinte recalculée différente")
    if sum(x["unites"] for x in b0["repartition"]) != b0["offre_totale"]:
        raise Refus("bloc 0 incohérent : la répartition ne fait pas l'offre totale")
    return b0


def appliquer(soldes, tx, bloc0, preuves, gele=False, hauteur=None):
    """Applique une transaction aux soldes (dict modifié) ou lève Refus. Les règles du bloc 0 sont ici.
    `hauteur` = bloc qui contient (ou contiendra) la transaction : il fixe le format signé exigé."""
    t, n = tx.get("type"), tx.get("unites")
    v2 = "regles:2" in preuves
    cle_reg = registre_tx(tx)
    if cle_reg in preuves:
        raise Refus("rejeu refusé : transaction déjà scellée ou déjà en attente")
    v3 = "signature" in tx and v3_active(hauteur)
    espace = ESPACE_TX_V3 if v3 else ESPACE_TX
    cle_seq = controler_v3(tx, bloc0, preuves, hauteur) if v3 else None
    if t not in ("allocation", "inscription", "regles", "epoque", "catalogue", "cle_producteur") and (
            not isinstance(n, int) or isinstance(n, bool) or n <= 0 or n > bloc0["offre_totale"]):
        raise Refus(f"{t} : unités invalides ({n!r})")

    def debiter(compte, u):
        if compte.startswith("reserve:") and compte not in ACTIVES and not gele:
            raise Refus(f"{compte} est bloquée")
        if soldes.get(compte, 0) < u:
            raise Refus(f"solde insuffisant sur {compte} ({soldes.get(compte, 0)} < {u})")
        soldes[compte] -= u

    def crediter(compte, u):
        soldes[compte] = soldes.get(compte, 0) + u

    def nom(x, quoi):
        if not isinstance(x, str) or not NOM.fullmatch(x):
            raise Refus(f"{quoi} invalide : {x!r}")
        return x

    if t == "allocation":
        if soldes:
            raise Refus("allocation hors genèse")
        for x in bloc0["repartition"]:
            crediter("reserve:" + x["categorie"], x["unites"])
        soldes["detruit"] = 0
        if isinstance(tx.get("horodatage"), str):   # première époque à clore : celle de la genèse, aucune sautée
            preuves.add(f"premiere_epoque:{max(0, epoque_de(tx['horodatage']))}")
    elif t == "achat":
        nom(tx.get("compte"), "compte")
        f = tx.get("facture", "")
        if not gele and not (isinstance(f, str) and re.fullmatch(r"ESSAI-[A-Za-z0-9-]{1,40}", f)):
            raise Refus("achat réel fermé ; en essai, la facture commence par ESSAI-")
        if f in preuves:
            raise Refus(f"facture déjà convertie : {f}")
        preuves.add(f)
        debiter("reserve:usage", n)
        crediter("compte:" + tx["compte"], n)
    elif t == "depense":
        nom(tx.get("compte"), "compte")
        if ADRESSE.fullmatch(tx["compte"]):
            # compte de portefeuille : seule la clé qui donne cette adresse peut dépenser
            if adresse(tx.get("cle", "")) != tx["compte"]:
                raise Refus("la clé ne correspond pas à l'adresse du compte")
            controler_signature(tx, tx["compte"], espace)
        elif tx.get("signature"):
            raise Refus("compte géré par le producteur : signature inattendue")
        if not isinstance(tx.get("service"), str) or not 0 < len(tx["service"]) <= 120:
            raise Refus("service absent ou trop long")
        debiter("compte:" + tx["compte"], n)
        detruit = n * DESTRUCTION_PCT // 100
        soldes["detruit"] += detruit
        if v2:   # 80 % recyclés dans la réserve qui paie les époques ; le nœud demandé reste une simple mention
            if tx.get("noeud"):
                nom(tx["noeud"], "nœud")
            crediter("reserve:usage", n - detruit)
        else:
            crediter("noeud:" + nom(tx["noeud"], "nœud") if tx.get("noeud") else "reserve:usage", n - detruit)
    elif t == "recompense":
        if v2:
            raise Refus("règles v2 : la récompense immédiate est remplacée par la clôture d'époque")
        nom(tx.get("noeud"), "nœud")
        p = tx.get("preuve")
        if not isinstance(p, str) or not re.fullmatch(r"[0-9a-f]{64}", p):
            raise Refus("récompense sans preuve (empreinte de l'étape)")
        if p in preuves:
            raise Refus(f"étape déjà récompensée : {p[:12]}…")
        preuves.add(p)
        debiter("reserve:usage", n)
        crediter("noeud:" + tx["noeud"], n)
    elif t == "inscription":
        # création d'un nœud : son nom et sa clé entrent au registre, signés par la clé du nœud elle-même
        nom(tx.get("noeud"), "nœud")
        if tx.get("adresse") != adresse(tx.get("cle", "")):
            raise Refus("inscription : adresse différente de celle de la clé")
        controler_signature(tx, tx["noeud"], espace)
        for cle_registre in ("inscrit:" + tx["noeud"], "cle:" + tx["adresse"]):
            if cle_registre in preuves:
                raise Refus(f"inscription en double ({cle_registre.split(':')[0]} déjà pris)")
            preuves.add(cle_registre)
    elif t == "catalogue":
        # offres de forfaits, publiées par le producteur ; chaque offre reste vérifiable par tous
        offres = tx.get("offres")
        if not isinstance(offres, dict) or not offres:
            raise Refus("catalogue vide")
        for oid, o in offres.items():
            nom(oid, "offre")
            if not (isinstance(o.get("centimes"), int) and o["centimes"] > 0 and isinstance(o.get("unites"), int)
                    and 0 < o["unites"] <= 10_000_000):
                raise Refus(f"offre {oid} invalide : prix en centimes d'euro et unités entières positifs")
            preuves.add(f"offre:{oid}:{o['centimes']}:{o['unites']}")
    elif t == "forfait":
        # achat d'un forfait : unités d'usage non cessibles (aucun transfert n'existe)
        nom(tx.get("compte"), "compte")
        if tx.get("client") is not None:
            nom(tx["client"], "client")
        if f"offre:{tx.get('offre')}:{tx.get('centimes')}:{n}" not in preuves:
            raise Refus("forfait hors catalogue : offre, prix ou unités différents du catalogue publié")
        f = tx.get("facture", "")
        if not gele and not (isinstance(f, str) and re.fullmatch(r"ESSAI-[A-Za-z0-9-]{1,40}", f)):
            raise Refus("vente réelle fermée sur la chaîne d'essai : facture ESSAI-… uniquement")
        if f in preuves:
            raise Refus(f"facture déjà convertie : {f}")
        preuves.add(f)
        debiter("reserve:usage", n)
        crediter("compte:" + tx["compte"], n)
    elif t == "consommation":
        # usage mesuré par la passerelle (demandes servies), débité par lots, chaque ligne une seule fois
        nom(tx.get("compte"), "compte")
        nom(tx.get("client"), "client")
        de, a_ = tx.get("de"), tx.get("a")
        if not (isinstance(de, int) and isinstance(a_, int) and 0 < de <= a_):
            raise Refus("consommation : plage de lignes d'usage invalide")
        deja = max([int(x.rsplit(":", 1)[1]) for x in preuves if x.startswith(f"conso:{tx['client']}:")] + [0])
        if de <= deja:
            raise Refus(f"consommation déjà débitée jusqu'à la ligne {deja}")
        debiter("compte:" + tx["compte"], n)
        detruit = n * DESTRUCTION_PCT // 100
        soldes["detruit"] += detruit
        crediter("reserve:usage", n - detruit)
        preuves.add(f"conso:{tx['client']}:{a_}")
    elif t == "regles":
        # mise à jour des règles à une hauteur donnée, sans réécrire le passé (comme une version à une époque)
        if tx.get("version") != 2 or v2:
            raise Refus("changement de règles : seule la v2 existe, et une seule fois")
        if not isinstance(tx.get("motif"), str) or not tx["motif"]:
            raise Refus("changement de règles sans motif")
        preuves.add("regles:2")
    elif t == "epoque":
        if not v2:
            raise Refus("clôture d'époque : règles v2 requises")
        k = tx.get("numero")
        deja = sorted(int(p.split(":")[1]) for p in preuves if p.startswith("epoque:"))
        premiere = next((int(p.split(":")[1]) for p in preuves if p.startswith("premiere_epoque:")), 0)
        attendu = deja[-1] + 1 if deja else premiere
        if not isinstance(k, int) or k < 0 or k != attendu:
            raise Refus(f"époque {k!r} hors séquence (attendue {attendu})")
        debut, fin = fenetre(k)
        if (tx.get("debut"), tx.get("fin")) != (debut, fin):
            raise Refus("fenêtre d'époque fausse")
        if not isinstance(tx.get("horodatage"), str) or tx["horodatage"] < fin:
            raise Refus(f"époque {k} pas encore terminée (fin {fin})")
        if tx.get("budget") != budget_epoque(k):
            raise Refus("budget d'époque faux")
        vus = set()
        for c in tx.get("contributions", []):
            nom(c.get("noeud"), "nœud")
            p = c.get("preuve", "")
            cle_p = p if c.get("role") == "travail" else "recu:" + p
            if not re.fullmatch(r"[0-9a-f]{64}", p) or cle_p in preuves or cle_p in vus:
                raise Refus(f"contribution invalide ou déjà payée : {p[:12]}…")
            if not debut <= str(c.get("horodatage", "")) < fin:
                raise Refus(f"contribution hors de l'époque {k} : {p[:12]}…")
            vus.add(cle_p)
        appuis = controler_independance(tx.get("contributions", []), nom)
        deja_cites = sorted(a for a in appuis if a in preuves)
        if deja_cites:
            raise Refus(f"reçu déjà cité pour payer une autre étape : {deja_cites[0][6:18]}…")
        r = repartir(tx.get("contributions", []), tx["budget"], soldes.get("reserve:usage", 0))
        if {k2: tx.get(k2) for k2 in r} != r:
            raise Refus("répartition d'époque différente du recalcul")
        debiter("reserve:usage", r["emis"]) if r["emis"] else None
        for noeud_, u in r["attributions"].items():
            crediter("noeud:" + noeud_, u)
        preuves.update(vus)
        preuves.update(appuis)
        preuves.add(f"epoque:{k}")
    elif t == "cle_producteur":
        # sans effet sur les soldes : `rejouer` contrôle la preuve et suit la clé à partir du bloc suivant
        if not isinstance(tx.get("motif"), str) or not tx["motif"]:
            raise Refus("changement de clé sans motif")
    else:
        raise Refus(f"type de transaction inconnu : {t!r} (aucune frappe, aucun transfert)")
    if sum(soldes.values()) != bloc0["offre_totale"]:
        raise Refus("conservation violée : soldes + détruit ≠ offre totale")
    preuves.add(cle_reg)
    if cle_seq:
        preuves.add(cle_seq)


def controler_independance(contributions, nom=None):
    """Règle « aucun nœud ne certifie seul sa récompense » (tâche #2034), rejouée par tout pair et tout témoin à partir
    de la seule transaction d'époque. Lève Refus ; renvoie les reçus cités (« appui:<empreinte> »), à ne citer qu'une
    fois dans toute la chaîne."""
    def nom_(x, quoi):
        if not isinstance(x, str) or not NOM.fullmatch(x):
            raise Refus(f"{quoi} invalide : {x!r}")
        return x
    nom = nom or nom_
    hexa = lambda p: isinstance(p, str) and re.fullmatch(r"[0-9a-f]{64}", p) is not None  # noqa: E731
    travaux = [c for c in contributions if c.get("role") == "travail"]
    validations = [c for c in contributions if c.get("role") == "validation"]
    par_preuve = {c.get("preuve"): c for c in validations}
    appuis = set()
    for c in validations:
        auteurs_ = c.get("auteurs")
        if not isinstance(auteurs_, list) or not auteurs_:
            raise Refus(f"validation sans auteurs de l'étape jugée : {str(c.get('preuve'))[:12]}…")
        for x in auteurs_:
            nom(x, "auteur d'étape")
        if c["noeud"] in auteurs_:
            raise Refus(f"auto-validation : {c['noeud']} juge une étape dont il est l'auteur "
                        f"({c.get('mission')}/{c.get('etape')})")
        if c.get("resultat") not in ("PASS", "FAIL"):
            raise Refus(f"validation sans résultat PASS ou FAIL : {str(c.get('preuve'))[:12]}…")
    for c in travaux:
        p, noeud = c.get("preuve"), c["noeud"]
        signataire = nom(c.get("signataire"), "signataire du journal de mission")
        if c.get("garantie") not in POIDS_GARANTIE:
            raise Refus(f"garantie inconnue : {c.get('garantie')!r}")
        recus = c.get("recus")
        if not isinstance(recus, list) or not recus:
            raise Refus(f"travail sans reçu indépendant : {noeud} certifierait seul l'étape {str(p)[:12]}…")
        for r in recus:
            if not isinstance(r, dict) or not hexa(r.get("preuve")) or r["preuve"] == p:
                raise Refus(f"reçu cité invalide pour l'étape {str(p)[:12]}…")
            v = nom(r.get("verificateur"), "vérificateur")
            if v in (noeud, signataire):
                raise Refus(f"reçu non indépendant : {v} est l'exécutant ou le signataire de l'étape {str(p)[:12]}…")
            if r.get("resultat") != "PASS" or r.get("garantie") not in POIDS_GARANTIE:
                raise Refus(f"reçu cité qui n'est pas un PASS : {r['preuve'][:12]}…")
            a = "appui:" + r["preuve"]
            if a in appuis:
                raise Refus(f"un même reçu paie deux étapes : {r['preuve'][:12]}…")
            appuis.add(a)
            scelle = par_preuve.get(r["preuve"])
            if scelle is not None and (scelle["noeud"] != v or scelle.get("resultat") != "PASS"
                                       or (scelle.get("mission"), scelle.get("etape")) != (c.get("mission"), c.get("etape"))):
                raise Refus(f"reçu cité différent de la validation scellée : {r['preuve'][:12]}…")
        if c["garantie"] == "rejeu-exact" and not any(r["garantie"] == "rejeu-exact" for r in recus):
            raise Refus(f"rejeu exact revendiqué sans reçu de rejeu exact : {str(p)[:12]}…")
        for v in validations:
            if (v.get("mission"), v.get("etape")) == (c.get("mission"), c.get("etape")):
                if not {noeud, signataire} <= set(v["auteurs"]):
                    raise Refus(f"auteurs de l'étape {str(p)[:12]}… différents entre travail et validation")
                if v["resultat"] == "FAIL":
                    raise Refus(f"étape payée malgré un reçu FAIL scellé : {str(p)[:12]}…")
    return appuis


def controler_recus_journal(contributions, vision=VISION):
    """Contrôle d'une clôture contre le journal VISION signé : chaque travail est une étape signée (même exécutant, même
    signataire), chaque reçu cité ou payé y est signé par le vérificateur nommé, avec ce résultat, pour cette étape, et
    les auteurs déclarés d'une étape jugée sont ceux du journal. Renvoie la liste des écarts ; None sans journal."""
    if verificateur_vision(vision) is None:
        return None
    signes = {x["preuve"]: x for x in recus_signes(vision)}
    etapes, auteurs_ = {}, {}
    for mission, env in etapes_signees(vision):
        e = env["evenement"]
        etapes[env.get("empreinte")] = (mission, e)
        auteurs_.setdefault((mission, e.get("sujet")), set()).update(x for x in auteurs(e) if x)
    ecarts = []
    for c in contributions:
        if c.get("role") == "validation":
            x = signes.get(c.get("preuve"))
            if x is None:
                ecarts.append(f"validation {str(c.get('preuve'))[:12]}… absente du journal signé")
            elif (x["verificateur"], x["resultat"], x["mission"], x["etape"]) != (
                    c.get("noeud"), c.get("resultat"), c.get("mission"), c.get("etape")):
                ecarts.append(f"validation {c['preuve'][:12]}… différente du journal signé")
            elif sorted(auteurs_.get((x["mission"], x["etape"]), ())) != sorted(c.get("auteurs") or []):
                ecarts.append(f"validation {c['preuve'][:12]}… : auteurs de l'étape différents du journal signé")
            continue
        if c.get("role") != "travail":
            continue
        m_e = etapes.get(c.get("preuve"))
        if m_e is None:
            ecarts.append(f"travail {str(c.get('preuve'))[:12]}… : étape absente du journal signé")
        else:
            mission, e = m_e
            if ((e.get("donnees") or {}).get("machine"), e.get("machine"), mission, e.get("sujet")) != (
                    c.get("noeud"), c.get("signataire"), c.get("mission"), c.get("etape")):
                ecarts.append(f"travail {c['preuve'][:12]}… différent de l'étape signée")
        for r in c.get("recus") or []:
            x = signes.get(r.get("preuve"))
            if x is None:
                ecarts.append(f"reçu {str(r.get('preuve'))[:12]}… absent du journal signé (étape {str(c.get('preuve'))[:12]}…)")
            elif (x["verificateur"], x["resultat"], x["mission"], x["etape"]) != (
                    r.get("verificateur"), r.get("resultat"), c.get("mission"), c.get("etape")):
                ecarts.append(f"reçu {r['preuve'][:12]}… différent du journal signé "
                              f"({x['verificateur']} {x['resultat']} {x['mission']}/{x['etape']})")
    return ecarts


def message_cle(ancienne, nouvelle, horodatage):
    return canon({"chaine": CHAINE, "ancienne": ancienne, "nouvelle": nouvelle, "horodatage": horodatage})


def controler_cle(tx, ancienne, i):
    """La nouvelle clé signe son propre passage : on ne déclare pas une clé qu'on ne tient pas."""
    ancienne, nouvelle = " ".join(ancienne.split()[:2]), str(tx.get("nouvelle", ""))
    if not PUB.fullmatch(nouvelle) or nouvelle == ancienne:
        raise Refus(f"bloc {i} : nouvelle clé de producteur invalide")
    if not verifier_sig(message_cle(ancienne, nouvelle, tx.get("horodatage")), tx.get("preuve", ""), nouvelle, PRODUCTEUR,
                        ESPACE_CLE):
        raise Refus(f"bloc {i} : preuve de possession de la nouvelle clé invalide")
    return nouvelle


def rejouer(blocs, bloc0, pub, verifier_signatures=True):
    """Vérifie toute la chaîne depuis la clé du bloc 1. Renvoie (soldes, preuves). Lève Refus au premier écart."""
    soldes, preuves, _, _ = _rejouer(blocs, bloc0, pub, verifier_signatures, 0, {}, set(), bloc0["empreinte"])
    return soldes, preuves


def _rejouer(blocs, bloc0, pub, verifier_signatures, i0, soldes, preuves, prec):
    """Rejoue blocs[i0:] à partir d'un état DÉJÀ vérifié (soldes, preuves, clé courante, empreinte du bloc i0).
    Mêmes contrôles que le rejeu complet ; renvoie (soldes, preuves, clé courante, empreinte de tête)."""
    for i, b in enumerate(blocs[i0:], start=i0 + 1):
        if b.get("chaine") != CHAINE or b.get("version_format") != FORMAT:
            raise Refus(f"bloc {i} : chaîne ou format inconnu")
        if b.get("hauteur") != i:
            raise Refus(f"bloc {i} : hauteur {b.get('hauteur')} au lieu de {i}")
        if b.get("precedent") != prec:
            raise Refus(f"bloc {i} : lien rompu avec le bloc {i - 1}")
        if b.get("bloc0") != bloc0["empreinte"]:
            raise Refus(f"bloc {i} : posé sur un autre bloc 0")
        txs = b.get("transactions") or []
        for tx in txs:
            if tx.get("id") != id_tx(tx):
                raise Refus(f"bloc {i} : transaction altérée")
        if b.get("racine") != merkle([tx["id"] for tx in txs]):
            raise Refus(f"bloc {i} : racine de Merkle fausse")
        if i == 1 and [tx.get("type") for tx in txs] != ["allocation"]:
            raise Refus("bloc 1 : la genèse d'essai ne contient que l'allocation")
        for tx in txs:
            try:
                appliquer(soldes, tx, bloc0, preuves, hauteur=i)
            except Refus as e:
                raise Refus(f"bloc {i} : {e}")
        if b.get("soldes") != sha(canon(soldes)):
            raise Refus(f"bloc {i} : empreinte des soldes fausse")
        if b.get("empreinte") != sha(canon(corps(b))):
            raise Refus(f"bloc {i} : empreinte du bloc fausse")
        if verifier_signatures and not verifier_sig(b["empreinte"], b.get("signature", ""), pub, PRODUCTEUR, ESPACE_BLOC):
            raise Refus(f"bloc {i} : signature du producteur invalide")
        if verifier_signatures:     # l'ancienne clé signe le bloc qui la remplace, la nouvelle vaut au bloc suivant
            for tx in txs:
                if tx.get("type") == "cle_producteur":
                    pub = controler_cle(tx, pub, i)
        prec = b["empreinte"]
    return soldes, preuves, pub, prec


# ── producteur (m0) ─────────────────────────────────────────────────────────────────────────────────
F_BLOCS, F_ATTENTE, F_COSIGN = "blocs.jsonl", "attente.jsonl", "cosignatures.jsonl"
F_GENESE = "producteur-genese.pub"


def pub_genese():
    """Clé du bloc 1, point de départ de tout rejeu. Les changements de clé se lisent ensuite dans la chaîne."""
    f = DOSSIER / F_GENESE
    return " ".join(f.read_text().split()[:2]) if f.exists() else pub_de(CLE)


def pub_courante(blocs):
    pub = pub_genese()
    for b in blocs:
        for tx in b.get("transactions") or []:
            if tx.get("type") == "cle_producteur":
                pub = tx["nouvelle"]
    return pub


_VERIFIE = {}   # (dossier, bloc0, clé de genèse) → (k, sha256 des k premières lignes, soldes, preuves, clé, tête)


def etat_courant():
    """État vérifié. Les k premières lignes déjà vérifiées OCTET POUR OCTET ne sont pas revérifiées ; tout le reste
    (blocs ajoutés) passe par exactement les mêmes contrôles. Une ligne ancienne modifiée annule le cache."""
    bloc0 = charger_bloc0()
    f = DOSSIER / F_BLOCS
    lignes = [l for l in f.read_text().splitlines() if l.strip()] if f.exists() else []
    blocs = [json.loads(l) for l in lignes]
    g = pub_genese()
    cle = (str(DOSSIER), bloc0["empreinte"], g)
    c = _VERIFIE.get(cle)
    if c and c[0] <= len(lignes) and c[1] == sha("\n".join(lignes[:c[0]])):
        r = _rejouer(blocs, bloc0, c[4], True, c[0], dict(c[2]), set(c[3]), c[5])
    else:
        r = _rejouer(blocs, bloc0, g, True, 0, {}, set(), bloc0["empreinte"])
    _VERIFIE[cle] = (len(lignes), sha("\n".join(lignes)), dict(r[0]), set(r[1]), r[2], r[3])
    return bloc0, blocs, r[0], r[1]


def verifier_suite(nouveaux):
    """Vérifie des blocs qui prolongent la chaîne locale à partir de son état vérifié (pas de rejeu complet)."""
    bloc0, blocs, soldes, preuves = etat_courant()
    c = _VERIFIE[(str(DOSSIER), bloc0["empreinte"], pub_genese())]
    _rejouer(blocs + list(nouveaux), bloc0, c[4], True, len(blocs), dict(soldes), set(preuves), c[5])


def produire(txs, bloc0, blocs, soldes, preuves):
    if pub_de(CLE) != pub_courante(blocs):
        raise Refus("clé de signature périmée : ce n'est pas la clé en cours de la chaîne")
    for tx in txs:
        tx["id"] = id_tx(tx)
    s, p = dict(soldes), set(preuves)
    for tx in txs:
        appliquer(s, tx, bloc0, p, hauteur=len(blocs) + 1)
        if tx.get("type") == "cle_producteur":   # même contrôle qu'au rejeu, AVANT de signer le bloc
            controler_cle(tx, pub_courante(blocs), len(blocs) + 1)
    b = {"chaine": CHAINE, "version_format": FORMAT, "hauteur": len(blocs) + 1,
         "precedent": blocs[-1]["empreinte"] if blocs else bloc0["empreinte"], "bloc0": bloc0["empreinte"],
         "horodatage": maintenant(), "producteur": PRODUCTEUR, "transactions": txs,
         "racine": merkle([tx["id"] for tx in txs]), "soldes": sha(canon(s)),
         "detruit": s.get("detruit", 0), "essai": True}
    b["empreinte"] = sha(canon(corps(b)))
    b["signature"] = signer(b["empreinte"], CLE, ESPACE_BLOC)
    ajouter_jsonl(DOSSIER / F_BLOCS, b)
    return b


def cmd_init(a):
    bloc0, blocs, soldes, preuves = etat_courant()
    if blocs:
        raise Refus("la genèse d'essai existe déjà")
    b = produire([{"type": "allocation", "horodatage": maintenant(), "source": "bloc0"}], bloc0, blocs, soldes, preuves)
    print(f"genèse d'essai : bloc 1 {b['empreinte'][:16]}… posé sur le bloc 0 {bloc0['empreinte'][:16]}…")


def mettre_en_attente(tx):
    bloc0, blocs, soldes, preuves = etat_courant()
    if not blocs:
        raise Refus("pas de genèse d'essai : lancer `vision-chaine init`")
    attente = lire_jsonl(DOSSIER / F_ATTENTE)
    s, p, h = dict(soldes), set(preuves), len(blocs) + 1
    for x in attente:
        appliquer(s, x, bloc0, p, hauteur=h)
    if "signature" not in tx:    # une transaction signée garde l'horodatage choisi par son signataire
        tx["horodatage"] = maintenant()
    tx["id"] = id_tx(tx)
    if any(x.get("id") == tx["id"] for x in attente):
        raise Refus("transaction déjà en attente")
    appliquer(s, tx, bloc0, p, hauteur=h)   # refuse tout de suite ce qui ne passerait pas au scellement
    if tx.get("type") == "cle_producteur":
        controler_cle(tx, pub_courante(blocs), h)
    ajouter_jsonl(DOSSIER / F_ATTENTE, tx)
    return tx


def cmd_acheter(a):
    tx = {"type": "achat", "compte": a.compte, "unites": a.unites, "facture": a.facture}
    if a.euros is not None:
        tx["euros"] = round(a.euros, 2)
    tx = mettre_en_attente(tx)
    print(f"achat en attente : {a.unites} VISION-essai pour compte:{a.compte} (facture {a.facture}) · {tx['id'][:12]}…")


def cmd_depenser(a):
