def ligne_justificatifs(blocs, vision=VISION):
    """Rejoue les justificatifs des clôtures scellées contre le journal VISION signé, s'il est là. Lève Refus sur écart."""
    clotures = [tx for b in blocs for tx in b["transactions"] if tx.get("type") == "epoque"]
    n = sum(len(tx.get("contributions", [])) for tx in clotures)
    if verificateur_vision(vision) is None:
        return (f"justificatifs : {len(clotures)} clôture(s) d'époque, règle d'indépendance rejouée ; "
                f"journal VISION absent ({vision}), reçus non confrontés au journal signé")
    for tx in clotures:
        ecarts = controler_recus_journal(tx.get("contributions", []), vision)
        if ecarts:
            raise Refus(f"clôture {tx.get('numero')} : {len(ecarts)} justificatif(s) hors du journal signé ({ecarts[0]})")
    return (f"justificatifs : {len(clotures)} clôture(s) d'époque, {n} contribution(s), toutes retrouvées dans le "
            f"journal VISION signé ({vision})")


