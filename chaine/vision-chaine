def lignes_facturables(client, apres, base=None):
    import sqlite3
    con = sqlite3.connect(f"file:{base or COCKPITS}?mode=ro", uri=True, timeout=10)
    try:
        return con.execute("select id, unites from usage where noeud_id=? and route='demander' and statut in (?,?,?) "
                           "and id>? order by id", (client, *FACTURABLE, apres)).fetchall()
    finally:
        con.close()


def cmd_consommer(a):
    _, blocs, soldes, preuves = etat_courant()
    comptes = {}
    for b in blocs:
        for tx in b["transactions"]:
            if tx.get("type") == "forfait" and tx.get("client"):
                comptes[tx["client"]] = tx["compte"]
    if not comptes:
        print("aucun client n'a de forfait : rien à décompter")
        return
    for client, compte in sorted(comptes.items()):
        deja = max([int(x.rsplit(":", 1)[1]) for x in preuves if x.startswith(f"conso:{client}:")] + [0])
        lignes = lignes_facturables(client, deja)
        u = sum(x[1] for x in lignes)
        if not lignes or u <= 0:
            print(f"{client} : rien de neuf depuis la ligne {deja}")
            continue
        solde = soldes.get("compte:" + compte, 0)
        print(f"{client} → compte:{compte} : {len(lignes)} demande(s) servie(s), {u} unité(s), solde {solde}")
        if a.projeter:
            continue
        if solde < u:
            print(f"  forfait épuisé ({solde} < {u}) : rien débité, la passerelle doit couper au quota")
            continue
        t = mettre_en_attente({"type": "consommation", "compte": compte, "client": client, "unites": u,
                               "de": lignes[0][0], "a": lignes[-1][0]})
        print(f"  consommation en attente · {t['id'][:12]}…")


