          f"{'noeud:' + a.noeud if a.noeud else 'reserve:usage'} · {tx['id'][:12]}…")


_OUTIL_VISION, _SIGNATURES = {}, {}


def verificateur_vision(vision=VISION):
    """Vérificateur d'événements de VISION, pris dans son dossier : une seule implémentation. None s'il manque."""
    vision = Path(vision)
    outil, signataires = vision / "trust/vision_evenement.py", vision / "trust/signataires"
    if not outil.exists() or not signataires.exists():
        return None
    if vision not in _OUTIL_VISION:
        chargeur = importlib.machinery.SourceFileLoader("vision_evenement_lu", str(outil))
        spec = importlib.util.spec_from_loader("vision_evenement_lu", chargeur)
        module = importlib.util.module_from_spec(spec)
        chargeur.exec_module(module)
        _OUTIL_VISION[vision] = module
    return lambda env: _OUTIL_VISION[vision].verifier(env, str(signataires))


def signe(env, verifier):
    """Vrai si l'enveloppe porte une signature valide d'une clé connue. Mémorisé : le portefeuille interroge toutes les 5 s."""
    cle = (str(env.get("empreinte")), str(env.get("signature")))
    if cle not in _SIGNATURES:
        try:
            verifier(env)
            _SIGNATURES[cle] = True
        except subprocess.SubprocessError:      # panne passagère, pas un refus : on ne la retient pas
            return False
        except Exception:  # noqa: BLE001 — tout le reste est un refus de signature
            _SIGNATURES[cle] = False
    return _SIGNATURES[cle]


def recus_signes(vision=VISION):
    """Reçus de travail VISION (v1 et v2) à la signature valide : vérificateur, résultat, force de la preuve. Lecture seule."""
    verifier = verificateur_vision(vision)
    if verifier is None:
        return []
    sortie = []
    for env in lire_jsonl(vision / "travail/recus-m0.jsonl"):
        if not signe(env, verifier):
            continue
        e = env.get("evenement") or {}
        d = e.get("donnees") or {}
        r = {"conforme": "PASS", "non-conforme": "FAIL"}.get(d.get("resultat"), d.get("resultat"))
        g = d.get("garantie") or ("rejeu-exact" if str(d.get("methode", "")).startswith("rejeu") else "proprietes")
        sortie.append({"mission": d.get("mission"), "etape": d.get("etape"), "resultat": r, "garantie": g,
                       "verificateur": e.get("machine"), "horodatage": e.get("horodatage"),
                       "preuve": env.get("empreinte")})
    return sortie


def etapes_signees(vision=VISION):
    """Étapes de mission VISION à la signature valide : (mission, enveloppe). Lecture seule."""
    verifier = verificateur_vision(vision)
    if verifier is None:
        return []
    sortie = []
    for j in sorted((vision / "federation/missions").glob("*/journal.jsonl")):
        for env in lire_jsonl(j):
            if (env.get("evenement") or {}).get("type") == "mission.etape" and signe(env, verifier):
                sortie.append((j.parent.name, env))
    return sortie


def auteurs(e):
    """Machines qui ne peuvent pas juger une étape : celle qui l'a exécutée et celle qui a signé le journal de la mission."""
    return {e.get("machine"), (e.get("donnees") or {}).get("machine")}


def etapes_validees(vision=VISION):
    """Étapes signées avec au moins un reçu PASS d'une autre machine et aucun FAIL. Lecture seule des journaux."""
    recus = {}
    for x in recus_signes(vision):
        recus.setdefault((x["mission"], x["etape"]), []).append(x)
    sortie = []
    for mission, env in etapes_signees(vision):
        e = env["evenement"]
        d = e.get("donnees") or {}
        lus = recus.get((mission, e.get("sujet")), [])
        libres = [x for x in lus if x["verificateur"] and x["verificateur"] not in auteurs(e)]
        if d.get("machine") and env.get("empreinte") and any(x["resultat"] == "PASS" for x in libres) \
                and not any(x["resultat"] == "FAIL" for x in lus):
            forte = any(x["resultat"] == "PASS" and x["garantie"] == "rejeu-exact" for x in libres)
            recus_ = sorted(({"preuve": x["preuve"], "verificateur": x["verificateur"], "resultat": "PASS",
                              "garantie": x["garantie"] if x["garantie"] in POIDS_GARANTIE else "proprietes"}
                             for x in libres if x["resultat"] == "PASS" and x["preuve"]),
                            key=lambda r: r["preuve"])
            sortie.append({"mission": mission, "etape": e.get("sujet"), "noeud": d["machine"],
                           "voie": d.get("voie"), "duree_ms": int(d.get("duree_ms") or 0),
                           "preuve": env["empreinte"], "horodatage": e.get("horodatage"),
                           "garantie": "rejeu-exact" if forte else "proprietes",
                           "signataire": e.get("machine"), "recus": recus_})
    return sortie


def contributions_epoque(k, preuves, vision=VISION):
    """Contributions de l'époque k pas encore payées : travail validé et validations signées."""
    debut, fin = fenetre(k)
    dedans = lambda h: isinstance(h, str) and debut <= h < fin  # noqa: E731
    cs = [{"role": "travail", "noeud": e["noeud"], "preuve": e["preuve"], "horodatage": e["horodatage"],
           "duree_ms": e["duree_ms"], "garantie": e["garantie"], "mission": e["mission"], "etape": e["etape"],
           "signataire": e["signataire"], "recus": [r for r in e["recus"] if "appui:" + r["preuve"] not in preuves]}
          for e in etapes_validees(vision) if dedans(e["horodatage"]) and e["preuve"] not in preuves]
    cs = [c for c in cs if c["recus"]]
    exclus = {}
    for mission, env in etapes_signees(vision):
        exclus.setdefault((mission, env["evenement"].get("sujet")), set()).update(auteurs(env["evenement"]))
    cs += [{"role": "validation", "noeud": r["verificateur"], "preuve": r["preuve"], "horodatage": r["horodatage"],
            "resultat": r["resultat"], "mission": r["mission"], "etape": r["etape"],
            "auteurs": sorted(x for x in exclus[(r["mission"], r["etape"])] if x)}
           for r in recus_signes(vision) if r["resultat"] in ("PASS", "FAIL") and r["preuve"] and r["verificateur"]
           and r["verificateur"] not in exclus.get((r["mission"], r["etape"]), {r["verificateur"]})
           and dedans(r["horodatage"]) and "recu:" + r["preuve"] not in preuves]
    return sorted(cs, key=lambda c: (c["horodatage"], c["preuve"]))


def projeter_epoque(k, soldes, preuves):
    debut, fin = fenetre(k)
    cs = contributions_epoque(k, preuves)
    tx = {"type": "epoque", "numero": k, "debut": debut, "fin": fin, "budget": budget_epoque(k), "contributions": cs}
    tx.update(repartir(cs, tx["budget"], soldes.get("reserve:usage", 0)))
    return tx


