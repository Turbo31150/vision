def cmd_epoque(a):
    bloc0, blocs, soldes, preuves = etat_courant()
    deja = sorted(int(p.split(":")[1]) for p in preuves if p.startswith("epoque:"))
    k = a.numero if a.numero is not None else (deja[-1] + 1 if deja else epoque_de(maintenant()))
    tx = projeter_epoque(k, soldes, preuves)
    termine = maintenant() >= tx["fin"]
    print(f"époque {k} : {tx['debut']} → {tx['fin']} ({'terminée' if termine else 'en cours'}) · budget {tx['budget']:_} · "
          f"{len(tx['contributions'])} contribution(s) · points justifiés {tx['justifie']} · émis {tx['emis']}".replace("_", " "))
    for n, s in tx["scores"].items():
        print(f"  {n:<14} {s:>6} points → {tx['attributions'].get(n, 0):>8} VISION-essai")
    if a.clore:
        if "regles:2" not in preuves:
            raise Refus("règles v2 non actives : lancer `vision-chaine regles-v2` puis sceller")
        if not termine:
            print(f"rien à clore : époque {k} pas encore terminée (fin {tx['fin']})")
            return
        while maintenant() >= tx["fin"]:   # toutes les époques terminées, dans l'ordre, aucune sautée
            ecarts = controler_recus_journal(tx["contributions"])
            if ecarts:
                raise Refus(f"clôture {tx['numero']} : {len(ecarts)} justificatif(s) hors du journal signé ({ecarts[0]})")
            t = mettre_en_attente(tx)
            print(f"clôture d'époque {tx['numero']} en attente : émis {tx['emis']} · {t['id'][:12]}…")
            s, p = etat_avec_attente()
            tx = projeter_epoque(tx["numero"] + 1, s, p)


