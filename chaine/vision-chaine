def cmd_temoin_init(a):
    d = Path(os.path.expanduser(a.dossier))
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    cle = d / f"{a.machine}_vision_ed25519"
    if not cle.exists():
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"vision-temoin-{a.machine}", "-f", str(cle)],
                       check=True, stdin=subprocess.DEVNULL, **SANS_FENETRE)
    (d / "producteur.pub").write_text(a.producteur_pub.strip() + "\n")
    (d / "machine").write_text(a.machine + "\n")
    print(pub_de(cle))


def cmd_cosigner(a):
    d = Path(os.path.expanduser(a.dossier))
    machine = (d / "machine").read_text().strip()
    pub = (d / "producteur.pub").read_text().strip()
    p = json.loads(sys.stdin.read())
    bloc0, blocs = p["bloc0"], p["blocs"]
    recalc = sha(json.dumps({k: v for k, v in bloc0.items() if k not in ("empreinte", "signature")},
                            ensure_ascii=False, sort_keys=True))
    if recalc != bloc0.get("empreinte"):
        raise Refus("bloc 0 reçu altéré")
    ancre = d / "bloc0.empreinte"
    if ancre.exists() and ancre.read_text().strip() != bloc0["empreinte"]:
        raise Refus("bloc 0 différent de celui épinglé par ce témoin")
    soldes, _ = rejouer(blocs, bloc0, pub)
    controle = ligne_justificatifs(blocs)
    histo = d / "tetes.jsonl"
    for t in lire_jsonl(histo):   # pas de retour en arrière ni de vue divergente
        if t["hauteur"] <= len(blocs) and blocs[t["hauteur"] - 1]["empreinte"] != t["empreinte"]:
            raise Refus(f"vue divergente à la hauteur {t['hauteur']}")
        if t["hauteur"] > len(blocs):
            raise Refus(f"retour en arrière : ce témoin a déjà vu la hauteur {t['hauteur']}")
    ancre.write_text(bloc0["empreinte"] + "\n")
    tete = blocs[-1]
    ajouter_jsonl(histo, {"hauteur": tete["hauteur"], "empreinte": tete["empreinte"], "vu_le": maintenant()})
    sig = signer(f"{tete['hauteur']}:{tete['empreinte']}", d / f"{machine}_vision_ed25519", ESPACE_COSIGN)
    print(canon({"machine": machine, "hauteur": tete["hauteur"], "empreinte": tete["empreinte"], "signature": sig,
                 "horodatage": maintenant(),
                 "soldes_controle": f"offre conservée {sum(soldes.values())}, détruit {soldes.get('detruit', 0)}",
                 "justificatifs": controle}))


def main():
    for _s in (sys.stdout, sys.stderr):
        if hasattr(_s, "reconfigure"):
            _s.reconfigure(encoding="utf-8", errors="replace")
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    s = ap.add_subparsers(dest="cmd", required=True)
    s.add_parser("init")
    x = s.add_parser("acheter")
    x.add_argument("--compte", required=True)
    x.add_argument("--unites", type=int, required=True)
    x.add_argument("--facture", required=True)
    x.add_argument("--euros", type=float)
    x = s.add_parser("depenser")
    x.add_argument("--compte", required=True)
    x.add_argument("--unites", type=int, required=True)
    x.add_argument("--service", required=True)
    x.add_argument("--noeud")
    x = s.add_parser("catalogue-publier")
    x.add_argument("--fichier", required=True)
    x = s.add_parser("forfait")
    x.add_argument("--compte", required=True)
    x.add_argument("--offre", required=True)
    x.add_argument("--facture", required=True)
    x.add_argument("--client")
    x = s.add_parser("consommer")
    x.add_argument("--projeter", action="store_true")
    x = s.add_parser("changer-cle")
    x.add_argument("--nouvelle", required=True)
    x.add_argument("--motif", required=True)
    x = s.add_parser("regles-v2")
    x.add_argument("--motif", required=True)
    x = s.add_parser("epoque")
    x.add_argument("--numero", type=int)
    x.add_argument("--clore", action="store_true")
    for c in ("sceller", "verifier", "etat", "soldes", "collecter"):
        s.add_parser(c)
    x = s.add_parser("exporter")
    x.add_argument("--sortie")
    x = s.add_parser("temoin-init")
    x.add_argument("--dossier", required=True)
    x.add_argument("--machine", required=True)
    x.add_argument("--producteur-pub", required=True)
    x = s.add_parser("cosigner")
    x.add_argument("--dossier", required=True)
    a = ap.parse_args()
    a.cmd = {"etat": "verifier"}.get(a.cmd, a.cmd)
    try:
        globals()["cmd_" + a.cmd.replace("-", "_")](a)
    except Refus as e:
        print(f"REFUS : {e}")
        return 1
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as e:
        print(f"ERREUR : {e.__class__.__name__} : {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
